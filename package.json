{
  "name": "parvath-finserv",
  "version": "1.0.0",
  "private": true,
  "type": "module",
  "engines": {
    "node": ">=24.11 <25"
  },
  "workspaces": [
    "apps/*",
    "packages/*"
  ],
  "scripts": {
    "dev": "concurrently -k -n api,web \"npm run dev -w apps/api\" \"npm run dev -w apps/web\"",
    "build": "npm run build -w apps/api && npm run build -w apps/web",
    "start": "node dist/apps/api/src/index.js",
    "typecheck": "tsc --noEmit && npm run typecheck -w apps/web",
    "lint": "eslint .",
    "test": "vitest run",
    "test:integration": "vitest run tests/api.test.ts",
    "db:migrate": "tsx apps/api/src/persistence/migrate.ts",
    "db:seed": "tsx apps/api/src/seed.ts",
    "db:seed:1000": "tsx scripts/seed-1000-clients.ts",
    "admin:create": "tsx apps/api/src/admin.ts",
    "worker": "tsx apps/api/src/worker.ts",
    "test:browser": "node scripts/browser-check.mjs",
    "test:ui": "node scripts/workspace-ui-check.mjs",
    "test:sweep": "node scripts/browser-sweep.mjs",
    "demo:cleanup": "tsx scripts/cleanup-demo-checks.ts",
    "docs:api": "node --import tsx scripts/generate-openapi.ts",
    "format:check": "prettier --check apps packages scripts tests",
    "db:local": "node scripts/local-mongo.mjs",
    "db:import-postgres": "tsx scripts/import-postgres.ts",
    "db:verify-cutover": "tsx scripts/verify-cutover.ts",
    "demo:refresh": "tsx scripts/refresh-demo-coverage.ts"
  },
  "dependencies": {
    "@aws-sdk/client-s3": "3.1135.0",
    "@aws-sdk/s3-request-presigner": "3.1135.0",
    "@dnd-kit/core": "6.3.1",
    "@hookform/resolvers": "5.9.1",
    "@tanstack/react-query": "5.103.1",
    "argon2": "0.45.1",
    "connect-mongo": "6.0.0",
    "cors": "2.8.6",
    "csv-parse": "7.0.2",
    "date-fns": "4.4.0",
    "date-fns-tz": "3.2.0",
    "dotenv": "18.0.0",
    "express": "5.2.1",
    "express-rate-limit": "8.7.0",
    "express-session": "1.19.0",
    "file-type": "22.1.1",
    "helmet": "8.3.0",
    "lucide-react": "1.47.0",
    "mongodb": "7.6.0",
    "multer": "2.4.0",
    "nodemailer": "10.0.10",
    "pino": "10.3.1",
    "pino-http": "11.0.0",
    "react": "19.3.0",
    "react-dom": "19.3.0",
    "react-hook-form": "7.88.0",
    "react-router-dom": "7.18.4",
    "recharts": "3.10.1",
    "zod": "4.6.5"
  },
  "devDependencies": {
    "@eslint/js": "10.0.1",
    "@playwright/test": "1.63.0",
    "@tailwindcss/vite": "4.3.3",
    "@testing-library/react": "16.3.3",
    "@types/cors": "2.8.19",
    "@types/express": "5.0.6",
    "@types/express-session": "1.19.0",
    "@types/multer": "2.2.0",
    "@types/node": "26.6.1",
    "@types/nodemailer": "8.0.2",
    "@types/pg": "8.23.1",
    "@types/react": "19.3.0",
    "@types/react-dom": "19.3.0",
    "@types/supertest": "7.2.1",
    "@vitejs/plugin-react": "6.1.1",
    "concurrently": "10.0.5",
    "eslint": "10.10.0",
    "globals": "17.12.0",
    "jsdom": "30.1.0",
    "pg": "8.23.0",
    "prettier": "3.9.8",
    "supertest": "7.2.2",
    "tailwindcss": "4.3.3",
    "tsx": "4.23.13",
    "typescript": "6.0.3",
    "typescript-eslint": "8.70.0",
    "vite": "8.3.0",
    "vitest": "5.0.1"
  }
}
