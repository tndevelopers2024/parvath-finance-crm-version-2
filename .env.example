# Node 24.11+; MongoDB Atlas or MongoDB 8 replica set. No PostgreSQL runtime.
NODE_ENV=development
PORT=4007
APP_ORIGIN=http://localhost:5177
# Extra exact origins allowed to call the API with cookies, comma separated. Required when the web app is
# served from another domain that proxies /api (e.g. https://your-app.vercel.app). No wildcards.
ALLOWED_ORIGINS=
# Atlas: mongodb+srv://USER:URL_ENCODED_PASSWORD@YOUR_CLUSTER.mongodb.net/?retryWrites=true&w=majority
# Store the real URI here or in a secret manager, never in frontend variables.
MONGODB_URI=mongodb://127.0.0.1:27027/?replicaSet=parvathLocal
MONGODB_DB=parvath_crm_dev
SESSION_SECRET=replace-with-at-least-32-random-characters
# Demo only: leave unset for normal development so the app uses the real clock (business day Asia/Kolkata).
# Set it to freeze the clock for the synthetic demo dataset. Production refuses it.
# Scripts that replace or add demo data (db:seed --reset, db:seed:1000, demo:refresh) require it, and also need
# --confirm-db=<MONGODB_DB> on the command line, e.g. npm run db:seed:1000 -- --confirm-db=parvath_crm_dev
# DEMO_DATE=2026-09-04T06:30:00.000Z
TRUST_PROXY=0
# 1 runs the job worker inside the API process instead of `npm run worker`. Railway defaults to 1.
INLINE_WORKER=0
# Private S3 bucket. Empty values disable uploads with a useful error.
S3_ENDPOINT=http://localhost:9000
S3_REGION=ap-south-1
S3_BUCKET=parvath-private
S3_ACCESS_KEY=
S3_SECRET_KEY=
CLAMAV_HOST=
CLAMAV_PORT=3310
SMTP_URL=
# Meta WhatsApp Cloud API for bulk WhatsApp broadcasts (leave empty to keep them disabled)
WHATSAPP_PHONE_NUMBER_ID=
WHATSAPP_ACCESS_TOKEN=
MAIL_FROM=Parvath FinServ <no-reply@example.com>
# Must differ from the app database and end in _test. Never use real client data.
TEST_MONGODB_URI=mongodb://127.0.0.1:27027/?replicaSet=parvathLocal
TEST_MONGODB_DB=parvath_crm_test
# Optional read-only source for the bounded one-time cutover tool, not runtime.
# LEGACY_POSTGRES_URL=postgresql://USER:PASSWORD@localhost:5432/legacy_crm
# ADMIN_EMAIL=you@example.com
# ADMIN_NAME=Your Name
# ADMIN_PASSWORD=generate-a-unique-12-plus-character-password
